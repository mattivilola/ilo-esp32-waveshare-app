{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ILO Board X News refresh messages v1",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "requestID"],
      "properties": {
        "type": { "const": "xNewsRefreshRequest" },
        "requestID": { "type": "string", "pattern": "^[A-Za-z0-9-]{1,64}$" }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "requestID", "status", "message"],
      "properties": {
        "type": { "const": "xNewsRefreshStatus" },
        "requestID": { "type": "string", "pattern": "^[A-Za-z0-9-]{1,64}$" },
        "status": { "enum": ["fetching", "updated", "disabled", "cooldown", "busy", "failed"] },
        "message": { "type": "string", "minLength": 1, "maxLength": 80 }
      }
    }
  ]
}

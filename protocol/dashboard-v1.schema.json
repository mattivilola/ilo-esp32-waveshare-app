{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://iloapps.com/schemas/ilo-board/dashboard-v1.schema.json",
  "title": "ILO Board dashboard snapshot",
  "type": "object",
  "additionalProperties": false,
  "required": ["protocolVersion", "revision", "generatedAt", "hostState", "capabilities", "tasks"],
  "properties": {
    "protocolVersion": { "const": 1 },
    "revision": { "type": "integer", "minimum": 0 },
    "generatedAt": { "type": "string", "format": "date-time" },
    "hostState": { "enum": ["online", "sleeping", "degraded"] },
    "codexEnabled": { "type": "boolean" },
    "xNewsEnabled": { "type": "boolean" },
    "companionVersion": { "type": ["string", "null"], "pattern": "^[A-Za-z0-9.()+ -]{1,32}$" },
    "capabilities": {
      "type": "array",
      "items": { "enum": ["tasks.read", "tasks.chat.read", "tasks.continue.fixed", "macPower.read", "hostTime.read", "xNews.read"] },
      "uniqueItems": true
    },
    "tasks": {
      "type": "array",
      "maxItems": 12,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title", "state", "attentionKind", "updatedAt", "shortSummary"],
        "properties": {
          "id": { "type": "string", "maxLength": 80 },
          "title": { "type": "string", "maxLength": 80 },
          "state": { "enum": ["active", "waiting", "completed", "failed", "idle"] },
          "attentionKind": { "enum": ["none", "question", "approval"] },
          "updatedAt": { "type": "string", "format": "date-time" },
          "shortSummary": { "type": "string", "maxLength": 180 }
        }
      }
    },
    "macPower": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["levelPercent", "state"],
      "properties": {
        "levelPercent": { "type": "integer", "minimum": 0, "maximum": 100 },
        "state": { "enum": ["battery", "charging", "powerAdapter", "full"] }
      }
    },
    "hostTime": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["utcOffsetSeconds", "timezoneAbbreviation"],
      "properties": {
        "utcOffsetSeconds": { "type": "integer", "minimum": -50400, "maximum": 50400 },
        "timezoneAbbreviation": { "type": "string", "pattern": "^[A-Za-z0-9+:-]{1,7}$" }
      }
    },
    "weatherLocation": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["name", "latitude", "longitude"],
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 40 },
        "latitude": { "type": "number", "minimum": -90, "maximum": 90 },
        "longitude": { "type": "number", "minimum": -180, "maximum": 180 }
      }
    },
    "newsFeed": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["generatedAt", "stories"],
      "properties": {
        "generatedAt": { "type": "string", "format": "date-time" },
        "stories": {
          "type": "array",
          "maxItems": 5,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "category", "headline", "summary", "confidence", "sources"],
            "properties": {
              "id": { "type": "string", "maxLength": 120 },
              "category": { "enum": ["AI", "Robotics"] },
              "headline": { "type": "string", "maxLength": 70 },
              "summary": { "type": "string", "maxLength": 220 },
              "confidence": { "enum": ["high", "medium"] },
              "sources": {
                "type": "array",
                "minItems": 1,
                "maxItems": 3,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["handle", "postedAt", "postURL"],
                  "properties": {
                    "handle": { "type": "string", "pattern": "^@[A-Za-z0-9_]{1,15}$" },
                    "postedAt": { "type": "string", "format": "date-time" },
                    "postURL": { "type": "string", "pattern": "^https://x[.]com/[A-Za-z0-9_]{1,15}/status/[0-9]+$" }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}

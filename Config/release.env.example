# Copy this file to Config/release.env and adjust the values for your Apple
# Developer account. The local file is ignored by Git.
ILO_BOARD_SIGNING_IDENTITY="Developer ID Application: Your Name (TEAMID)"
ILO_BOARD_NOTARY_PROFILE="ilo-board-notary"

# Run `make sparkle-generate-keys` once, then copy only the printed public key
# here. Sparkle stores the private EdDSA key in the login Keychain.
ILO_BOARD_SPARKLE_PUBLIC_ED_KEY="BASE64_PUBLIC_KEY"

# Optional directory containing Sparkle's generate_keys and sign_update tools.
# The scripts normally discover these from SwiftPM automatically.
# ILO_BOARD_SPARKLE_TOOLS_DIR="/path/to/Sparkle/bin"

# Public Google Cloud Storage destinations. Override these only when publishing
# somewhere other than the project's default public bucket path.
ILO_BOARD_PUBLIC_RELEASE_URI="gs://ilo-public/ilo-board/ILOBoard-latest.dmg"
ILO_BOARD_PUBLIC_VERSIONED_RELEASES_URI="gs://ilo-public/ilo-board/releases"
ILO_BOARD_PUBLIC_VERSIONED_RELEASES_URL="https://storage.googleapis.com/ilo-public/ilo-board/releases"
ILO_BOARD_PUBLIC_APPCAST_URI="gs://ilo-public/ilo-board/appcast.xml"
ILO_BOARD_PUBLIC_APPCAST_URL="https://storage.googleapis.com/ilo-public/ilo-board/appcast.xml"

# Firmware OTA trust material. Keep the RSA-3072 private key outside this
# repository and outside cloud storage. The public PEM may be copied into the
# signed firmware at build time, but is not a remotely replaceable trust root.
ILO_BOARD_FIRMWARE_SIGNING_KEY="/secure/offline/path/ilo-board-firmware-rsa3072.pem"
ILO_BOARD_FIRMWARE_PUBLIC_KEY="/secure/offline/path/ilo-board-firmware-rsa3072-public.pem"

# Increment this monotonically for every published firmware manifest. Reusing
# or decreasing it is rejected by the distribution tooling and the board.
ILO_BOARD_FIRMWARE_RELEASE_SEQUENCE="1"
ILO_BOARD_FIRMWARE_RELEASE_NOTE_1="Describe the first verified firmware change."
# ILO_BOARD_FIRMWARE_RELEASE_NOTE_2="Describe another verified change."

ILO_BOARD_FIRMWARE_RELEASES_URI="gs://ilo-public/ilo-board/firmware/releases"
ILO_BOARD_FIRMWARE_MANIFEST_URI="gs://ilo-public/ilo-board/firmware/manifest-v1.json"

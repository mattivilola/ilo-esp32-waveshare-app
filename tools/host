#!/usr/bin/env python3
"""Development lifecycle CLI for the native ILO Board macOS companion."""

from __future__ import annotations

import argparse
from pathlib import Path
import shutil
import subprocess


ROOT = Path(__file__).resolve().parent.parent
PACKAGE = ROOT / "mac-service"


def run(arguments: list[str]) -> None:
    swift = shutil.which("swift")
    if swift is None:
        raise SystemExit("Swift is not installed. Install Xcode Command Line Tools first.")
    command = [swift, arguments[0], "--package-path", str(PACKAGE), *arguments[1:]]
    print("+ " + " ".join(command))
    subprocess.run(command, cwd=ROOT, check=True)


def build(_: argparse.Namespace) -> None:
    run(["build"])


def test(_: argparse.Namespace) -> None:
    run(["test"])


def menu(_: argparse.Namespace) -> None:
    run(["run", "ILOBoardMenu"])


def snapshot(arguments: argparse.Namespace) -> None:
    command = ["run", "ilo-board-host", "snapshot"]
    if arguments.mock:
        command.append("--mock")
    run(command)


def serve(arguments: argparse.Namespace) -> None:
    command = ["run", "ilo-board-host", "serve"]
    if arguments.mock:
        command.append("--mock")
    if arguments.usb_only:
        command.append("--usb-only")
    run(command)


def screenshot(arguments: argparse.Namespace) -> None:
    command = ["run", "ilo-board-host", "screenshot", "--output", arguments.output]
    if arguments.timeout is not None:
        command.extend(("--timeout", str(arguments.timeout)))
    if arguments.force:
        command.append("--force")
    if arguments.usb_only:
        command.append("--usb-only")
    run(command)


def x_news(arguments: argparse.Namespace) -> None:
    command = ["run", "ilo-board-host", "x-news", arguments.action]
    if arguments.allow_grok_tools:
        command.append("--allow-grok-tools")
    if arguments.twice_daily:
        command.append("--twice-daily")
    run(command)


def doctor(_: argparse.Namespace) -> None:
    run(["run", "ilo-board-host", "doctor"])


def parser() -> argparse.ArgumentParser:
    result = argparse.ArgumentParser(prog="host", description=__doc__)
    commands = result.add_subparsers(dest="command", required=True)
    for name, help_text, handler in (
        ("build", "build the Swift package", build),
        ("test", "run all host tests", test),
        ("menu", "run the menu-bar companion", menu),
        ("snapshot", "print one sanitized Codex status snapshot", snapshot),
        ("serve", "run the headless Codex status service", serve),
        ("doctor", "show host protocol capabilities", doctor),
        ("screenshot", "capture the authenticated live board framebuffer as PNG", screenshot),
        ("x-news", "inspect or refresh the optional verified Grok X News cache", x_news),
    ):
        command = commands.add_parser(name, help=help_text)
        if name in ("snapshot", "serve"):
            command.add_argument("--mock", action="store_true", help="use deterministic sample tasks instead of Codex history")
        if name == "serve":
            command.add_argument("--usb-only", action="store_true", help="open only the authenticated USB fallback for diagnostics")
        if name == "screenshot":
            command.add_argument("--output", required=True, help="destination PNG path")
            command.add_argument("--timeout", type=int, help="seconds to wait for the paired board (default: 45)")
            command.add_argument("--force", action="store_true", help="replace an existing output file")
            command.add_argument("--usb-only", action="store_true", help="disable Wi-Fi listener and verify USB fallback only")
        if name == "x-news":
            command.add_argument("action", choices=("status", "refresh", "enable", "disable"))
            command.add_argument(
                "--allow-grok-tools",
                action="store_true",
                help="explicitly allow the authenticated Grok CLI to search X for this refresh",
            )
            command.add_argument(
                "--twice-daily",
                action="store_true",
                help="when enabling, refresh at 08:00 and 14:00 local instead of once daily",
            )
        command.set_defaults(handler=handler)
    return result


if __name__ == "__main__":
    arguments = parser().parse_args()
    arguments.handler(arguments)

#!/usr/bin/env python3
"""Safe board lifecycle CLI for Waveshare ESP32-S3-Touch-LCD-5B SKU 28151."""

from __future__ import annotations

import argparse
import datetime as dt
import glob
import hashlib
import os
from pathlib import Path
import shutil
import subprocess
import sys


ROOT = Path(__file__).resolve().parent.parent
FIRMWARE = ROOT / "firmware"
VENV = ROOT / ".tools" / "board-python"
ESPTOOL = VENV / "bin" / "esptool"
IDF = ROOT / "tools" / "idf"
EXPECTED_FLASH_BYTES = 0x1000000


def candidate_ports() -> list[str]:
    patterns = (
        "/dev/cu.usbmodem*",
        "/dev/cu.usbserial*",
        "/dev/cu.wchusbserial*",
        "/dev/cu.SLAB_USBtoUART*",
    )
    ports: list[str] = []
    for pattern in patterns:
        ports.extend(glob.glob(pattern))
    return sorted(set(ports), key=lambda value: os.path.getmtime(value), reverse=True)


def resolve_port(explicit: str | None) -> str:
    if explicit:
        if not Path(explicit).exists():
            raise SystemExit(f"Serial port does not exist: {explicit}")
        return explicit
    ports = candidate_ports()
    if not ports:
        raise SystemExit("No ESP serial port found. Connect the board and run `./tools/board doctor`.")
    if len(ports) > 1:
        raise SystemExit("Multiple candidate ports found; pass --port explicitly:\n  " + "\n  ".join(ports))
    return ports[0]


def run(command: list[str], cwd: Path = ROOT) -> None:
    print("+ " + " ".join(command))
    subprocess.run(command, cwd=cwd, check=True)


def ensure_esptool() -> None:
    if ESPTOOL.exists():
        return
    print("Creating isolated board utility environment...")
    VENV.parent.mkdir(parents=True, exist_ok=True)
    run([sys.executable, "-m", "venv", str(VENV)])
    run([str(VENV / "bin" / "python"), "-m", "pip", "install", "esptool==5.3.1", "pyserial==3.5"])


def esptool(port: str, *arguments: str) -> None:
    ensure_esptool()
    run([str(ESPTOOL), "--chip", "esp32s3", "--port", port, *arguments])


def doctor(_: argparse.Namespace) -> None:
    print("ILO Board doctor")
    print(f"  repository: {ROOT}")
    print(f"  ESP-IDF: {'installed' if (ROOT / '.tools/esp-idf/export.sh').exists() else 'not installed'}")
    print(f"  esptool: {'installed' if ESPTOOL.exists() else 'not installed (created on first hardware command)'}")
    ports = candidate_ports()
    if ports:
        for port in ports:
            print(f"  serial: {port}")
    else:
        print("  serial: no ESP-compatible port detected")
    print(f"  Swift: {shutil.which('swift') or 'not found'}")
    print(f"  CMake: {shutil.which('cmake') or 'not found'}")
    print(f"  Ninja: {shutil.which('ninja') or 'not found'}")


def chip_id(args: argparse.Namespace) -> None:
    esptool(resolve_port(args.port), "chip-id")


def backup(args: argparse.Namespace) -> None:
    port = resolve_port(args.port)
    output_dir = ROOT / "artifacts" / "factory-backups"
    output_dir.mkdir(parents=True, exist_ok=True)
    stamp = dt.datetime.now().astimezone().strftime("%Y-%m-%dT%H%M%S%z")
    output = output_dir / f"waveshare-esp32s3-{stamp}.bin"
    esptool(port, "read-flash", "--no-progress", "0x0", hex(EXPECTED_FLASH_BYTES), str(output))
    if output.stat().st_size != EXPECTED_FLASH_BYTES:
        raise SystemExit(f"Backup has unexpected size: {output.stat().st_size} bytes")
    digest = hashlib.sha256(output.read_bytes()).hexdigest()
    print(f"Backup: {output}")
    print(f"SHA-256: {digest}")


def build(_: argparse.Namespace) -> None:
    run([str(IDF), "idf.py", "-D", "IDF_TARGET=esp32s3", "build"], cwd=FIRMWARE)


def flash(args: argparse.Namespace) -> None:
    port = resolve_port(args.port)
    run([str(IDF), "idf.py", "-p", port, "flash"], cwd=FIRMWARE)


def monitor(args: argparse.Namespace) -> None:
    port = resolve_port(args.port)
    run([str(IDF), "idf.py", "-p", port, "monitor"], cwd=FIRMWARE)


def reboot(args: argparse.Namespace) -> None:
    esptool(resolve_port(args.port), "run")


def erase(args: argparse.Namespace) -> None:
    if args.confirm != "ERASE-ENTIRE-BOARD":
        raise SystemExit("Refusing to erase. Re-run with --confirm ERASE-ENTIRE-BOARD.")
    esptool(resolve_port(args.port), "erase-flash")


def restore(args: argparse.Namespace) -> None:
    image = Path(args.image).expanduser().resolve()
    if args.confirm != "RESTORE-FACTORY-IMAGE":
        raise SystemExit("Refusing to overwrite flash. Re-run with --confirm RESTORE-FACTORY-IMAGE.")
    if not image.is_file() or image.stat().st_size != EXPECTED_FLASH_BYTES:
        raise SystemExit("Restore image must be an existing 16 MB full-flash backup.")
    esptool(resolve_port(args.port), "write-flash", "0x0", str(image))


def parser() -> argparse.ArgumentParser:
    result = argparse.ArgumentParser(prog="board", description=__doc__)
    sub = result.add_subparsers(dest="command", required=True)
    sub.add_parser("doctor", help="show local toolchain and USB status").set_defaults(handler=doctor)
    for name, help_text, handler in (
        ("chip-id", "identify the connected chip without changing flash", chip_id),
        ("backup", "read a verified 16 MB full-flash backup", backup),
        ("flash", "build as needed and flash the application", flash),
        ("monitor", "open the ESP-IDF serial monitor", monitor),
        ("reboot", "hard-reset the board", reboot),
    ):
        command = sub.add_parser(name, help=help_text)
        command.add_argument("--port")
        command.set_defaults(handler=handler)
    sub.add_parser("build", help="configure and build firmware").set_defaults(handler=build)
    erase_parser = sub.add_parser("erase", help="erase the entire board (explicit confirmation required)")
    erase_parser.add_argument("--port")
    erase_parser.add_argument("--confirm")
    erase_parser.set_defaults(handler=erase)
    restore_parser = sub.add_parser("restore", help="restore a 16 MB full-flash backup")
    restore_parser.add_argument("image")
    restore_parser.add_argument("--port")
    restore_parser.add_argument("--confirm")
    restore_parser.set_defaults(handler=restore)
    return result


if __name__ == "__main__":
    arguments = parser().parse_args()
    arguments.handler(arguments)

from __future__ import annotations

import argparse
import csv
import datetime as dt
import getpass
import glob
import hashlib
import json
import math
import os
from pathlib import Path
import secrets
import shutil
import socket
import subprocess
import sys
import tempfile
import uuid


ROOT = Path(__file__).resolve().parent.parent
FIRMWARE = ROOT / "firmware"
FIRMWARE_VERSION_SCRIPT = ROOT / "scripts" / "firmware_version.sh"
VENV = ROOT / ".tools" / "board-python"
ESPTOOL = VENV / "bin" / "esptool"
IDF = ROOT / "tools" / "idf"
EXPECTED_FLASH_BYTES = 0x1000000
NVS_PARTITION = ROOT / "firmware" / "partitions.csv"
NVS_GENERATOR = ROOT / ".tools" / "esp-idf" / "components" / "nvs_flash" / "nvs_partition_generator" / "nvs_partition_gen.py"
ESPSECURE = ROOT / ".tools" / "esp-idf" / "components" / "esptool_py" / "esptool" / "espsecure.py"
ESPTOOL_PY = ROOT / ".tools" / "esp-idf" / "components" / "esptool_py" / "esptool" / "esptool.py"
IDF_PYTHON_ROOT = ROOT / ".tools" / "espressif" / "python_env"
HOST_PACKAGE = ROOT / "mac-service"
HOST_CONFIG = Path.home() / "Library" / "Application Support" / "ILO Board Host" / "board.json"
DEFAULT_HOST_PORT = 47472


def candidate_ports() -> list[str]:
    patterns = (
        "/dev/cu.usbmodem*",
        "/dev/cu.usbserial*",
        "/dev/cu.wchusbserial*",
        "/dev/cu.SLAB_USBtoUART*",
    )
    ports: list[str] = []
    for pattern in patterns:
        ports.extend(glob.glob(pattern))
    return sorted(set(ports), key=lambda value: os.path.getmtime(value), reverse=True)


def resolve_port(explicit: str | None) -> str:
    if explicit:
        if not Path(explicit).exists():
            raise SystemExit(f"Serial port does not exist: {explicit}")
        return explicit
    ports = candidate_ports()
    if not ports:
        raise SystemExit("No ESP serial port found. Connect the board and run `./tools/board doctor`.")
    if len(ports) > 1:
        raise SystemExit("Multiple candidate ports found; pass --port explicitly:\n  " + "\n  ".join(ports))
    return ports[0]


def run(command: list[str], cwd: Path = ROOT, input_text: str | None = None) -> None:
    print("+ " + " ".join(command))
    subprocess.run(command, cwd=cwd, check=True, input=input_text, text=input_text is not None)


def ensure_esptool() -> None:
    if ESPTOOL.exists():
        return
    print("Creating isolated board utility environment...")
    VENV.parent.mkdir(parents=True, exist_ok=True)
    run([sys.executable, "-m", "venv", str(VENV)])
    run([str(VENV / "bin" / "python"), "-m", "pip", "install", "esptool==5.3.1", "pyserial==3.5"])


def esptool(port: str, *arguments: str) -> None:
    ensure_esptool()
    run([str(ESPTOOL), "--chip", "esp32s3", "--port", port, *arguments])


def doctor(_: argparse.Namespace) -> None:
    print("ILO Board doctor")
    print(f"  repository: {ROOT}")
    print(f"  ESP-IDF: {'installed' if (ROOT / '.tools/esp-idf/export.sh').exists() else 'not installed'}")
    print(f"  esptool: {'installed' if ESPTOOL.exists() else 'not installed (created on first hardware command)'}")
    ports = candidate_ports()
    if ports:
        for port in ports:
            print(f"  serial: {port}")
    else:
        print("  serial: no ESP-compatible port detected")
    print(f"  Swift: {shutil.which('swift') or 'not found'}")
    print(f"  CMake: {shutil.which('cmake') or 'not found'}")
    print(f"  Ninja: {shutil.which('ninja') or 'not found'}")
    try:
        layout = validate_ota_layout(NVS_PARTITION)
        print(f"  OTA layout: rollback-safe ({layout['slot_size']} bytes per slot)")
    except SystemExit as error:
        print(f"  OTA layout: invalid ({error})")


def chip_id(args: argparse.Namespace) -> None:
    esptool(resolve_port(args.port), "chip-id")


def backup(args: argparse.Namespace) -> None:
    port = resolve_port(args.port)
    output_dir = ROOT / "artifacts" / "factory-backups"
    output_dir.mkdir(parents=True, exist_ok=True)
    stamp = dt.datetime.now().astimezone().strftime("%Y-%m-%dT%H%M%S%z")
    output = output_dir / f"waveshare-esp32s3-{stamp}.bin"
    esptool(port, "read-flash", "--no-progress", "0x0", hex(EXPECTED_FLASH_BYTES), str(output))
    if output.stat().st_size != EXPECTED_FLASH_BYTES:
        raise SystemExit(f"Backup has unexpected size: {output.stat().st_size} bytes")
    digest = hashlib.sha256(output.read_bytes()).hexdigest()
    print(f"Backup: {output}")
    print(f"SHA-256: {digest}")


def build(_: argparse.Namespace) -> None:
    run([str(IDF), "idf.py", "-D", "IDF_TARGET=esp32s3", "build"], cwd=FIRMWARE)


def read_sdkconfig(path: Path) -> dict[str, str]:
    if not path.is_file():
        raise SystemExit(f"SDK configuration does not exist: {path}")
    values: dict[str, str] = {}
    for raw_line in path.read_text().splitlines():
        line = raw_line.strip()
        if not line or line.startswith("#") or "=" not in line:
            continue
        key, value = line.split("=", 1)
        values[key.strip()] = value.strip().strip('"')
    return values


def validate_ota_layout(path: Path) -> dict[str, int]:
    if not path.is_file():
        raise SystemExit(f"Partition table does not exist: {path}")
    partitions: list[dict[str, int | str]] = []
    with path.open(newline="") as source:
        for row in csv.reader(line for line in source if line.strip() and not line.lstrip().startswith("#")):
            if len(row) < 5:
                raise SystemExit("Partition table contains an incomplete row.")
            name, kind, subtype, offset, size = (field.strip() for field in row[:5])
            try:
                parsed_offset = int(offset, 0)
                parsed_size = int(size, 0)
            except ValueError as error:
                raise SystemExit(f"Partition {name} must have explicit numeric offset and size.") from error
            partitions.append({
                "name": name,
                "type": kind,
                "subtype": subtype,
                "offset": parsed_offset,
                "size": parsed_size,
            })

    if any(item["type"] == "app" and item["subtype"] in ("factory", "test") for item in partitions):
        raise SystemExit("Rollback policy forbids factory and test app partitions.")
    slots = [item for item in partitions if item["type"] == "app" and item["subtype"] in ("ota_0", "ota_1")]
    if len(slots) != 2 or {item["subtype"] for item in slots} != {"ota_0", "ota_1"}:
        raise SystemExit("Partition table must contain exactly ota_0 and ota_1 application slots.")
    if slots[0]["size"] != slots[1]["size"]:
        raise SystemExit("ota_0 and ota_1 must have identical sizes.")
    if any(int(item["offset"]) % 0x10000 != 0 for item in slots):
        raise SystemExit("OTA application offsets must be aligned to 64 KiB.")
    ota_data = [item for item in partitions if item["type"] == "data" and item["subtype"] == "ota"]
    if len(ota_data) != 1 or int(ota_data[0]["size"]) < 0x2000:
        raise SystemExit("Partition table must contain one otadata partition of at least 0x2000 bytes.")
    ordered = sorted(partitions, key=lambda item: int(item["offset"]))
    for previous, current in zip(ordered, ordered[1:]):
        if int(previous["offset"]) + int(previous["size"]) > int(current["offset"]):
            raise SystemExit(f"Partitions {previous['name']} and {current['name']} overlap.")
    flash_end = max(int(item["offset"]) + int(item["size"]) for item in partitions)
    if flash_end > EXPECTED_FLASH_BYTES:
        raise SystemExit("Partition table exceeds the board's 16 MB flash.")
    return {
        "slot_size": int(slots[0]["size"]),
        "ota_0_offset": int(next(item["offset"] for item in slots if item["subtype"] == "ota_0")),
        "ota_1_offset": int(next(item["offset"] for item in slots if item["subtype"] == "ota_1")),
    }


def ota_release_policy_errors(config: dict[str, str]) -> list[str]:
    errors: list[str] = []
    if config.get("CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE") != "y":
        errors.append("bootloader rollback is not enabled")
    secure_boot = config.get("CONFIG_SECURE_BOOT") == "y"
    signed_without_secure_boot = config.get("CONFIG_SECURE_SIGNED_APPS_NO_SECURE_BOOT") == "y"
    if not secure_boot and not signed_without_secure_boot:
        errors.append("signed application verification is not enabled")
    if not secure_boot and config.get("CONFIG_SECURE_SIGNED_ON_UPDATE_NO_SECURE_BOOT") != "y":
        errors.append("signature verification on OTA update is not enabled")
    if not secure_boot and config.get("CONFIG_SECURE_SIGNED_APPS_RSA_SCHEME") != "y":
        errors.append("ESP32-S3 release profile must use RSA secure-boot-v2 signatures")
    return errors


def ota_status(args: argparse.Namespace) -> None:
    layout = validate_ota_layout(NVS_PARTITION)
    sdkconfig = Path(args.sdkconfig).expanduser().resolve() if args.sdkconfig else FIRMWARE / "sdkconfig"
    if not sdkconfig.is_file():
        sdkconfig = FIRMWARE / "sdkconfig.defaults"
    config = read_sdkconfig(sdkconfig)
    errors = ota_release_policy_errors(config)
    print("ILO Board OTA status (read-only)")
    print(f"  slots: ota_0 + ota_1, {layout['slot_size']} bytes each")
    print(f"  rollback: {'enabled' if config.get('CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE') == 'y' else 'disabled in selected sdkconfig'}")
    print(f"  signed update policy: {'ready' if not errors else 'BLOCKED'}")
    print("  update ingress: disabled (no upload/install command is implemented)")
    print("  production secure boot/eFuse provisioning: not performed")
    for error in errors:
        print(f"  gate: {error}")


def public_verification_key(path: Path) -> None:
    if not path.is_file():
        raise SystemExit(f"Public verification key does not exist: {path}")
    payload = path.read_bytes()
    if b"PRIVATE KEY" in payload:
        raise SystemExit("Refusing a private key. Pass an RSA public verification key only.")
    if b"BEGIN PUBLIC KEY" not in payload and b"BEGIN RSA PUBLIC KEY" not in payload:
        raise SystemExit("Verification key must be a PEM public key.")


def ota_verify(args: argparse.Namespace) -> None:
    image = Path(args.image).expanduser().resolve()
    public_key = Path(args.public_key).expanduser().resolve()
    sdkconfig = Path(args.sdkconfig).expanduser().resolve()
    if not image.is_file() or image.stat().st_size == 0:
        raise SystemExit("OTA image must be a non-empty existing file.")
    layout = validate_ota_layout(NVS_PARTITION)
    if image.stat().st_size > layout["slot_size"]:
        raise SystemExit("OTA image is larger than an application slot.")
    errors = ota_release_policy_errors(read_sdkconfig(sdkconfig))
    if errors:
        raise SystemExit("Release SDK configuration is unsafe: " + "; ".join(errors))
    public_verification_key(public_key)
    if not ESPSECURE.is_file() or not ESPTOOL_PY.is_file():
        raise SystemExit("Pinned ESP-IDF verification tools are missing. Run `./tools/setup-idf`.")
    python = idf_python()
    image_check = subprocess.run(
        [str(python), str(ESPTOOL_PY), "image_info", "--version", "2", str(image)],
        cwd=ROOT,
        text=True,
        capture_output=True,
    )
    if image_check.returncode != 0:
        raise SystemExit("Artifact is not a valid ESP application image.")
    signature_check = subprocess.run(
        [str(python), str(ESPSECURE), "verify_signature", "--version", "2", "--keyfile", str(public_key), str(image)],
        cwd=ROOT,
        text=True,
        capture_output=True,
    )
    if signature_check.returncode != 0:
        raise SystemExit("RSA signature verification failed; artifact is blocked.")
    digest = hashlib.sha256(image.read_bytes()).hexdigest()
    print("OTA release artifact verified (no upload performed)")
    print(f"  bytes: {image.stat().st_size}")
    print(f"  SHA-256: {digest}")
    print("  signature: valid RSA secure-boot-v2 signature")
    print("  next gate: physical rollback/recovery validation before enabling delivery")


def swift_preview(*arguments: str) -> None:
    swift = shutil.which("swift")
    if swift is None:
        raise SystemExit("Swift is not installed. Install Xcode Command Line Tools first.")
    run([swift, "run", "--package-path", str(HOST_PACKAGE), "ilo-board-preview", *arguments])


def ui_preview(args: argparse.Namespace) -> None:
    arguments = ["preview"]
    if args.without_x_news:
        arguments.append("--without-x-news")
    swift_preview(*arguments)


def ui_screenshot(args: argparse.Namespace) -> None:
    if args.all:
        arguments = ["screenshots"]
        if args.output:
            arguments.extend(("--output-dir", args.output))
    else:
        arguments = ["screenshot", "--screen", args.screen]
        if args.output:
            arguments.extend(("--output", args.output))
    swift_preview(*arguments)


def flash(args: argparse.Namespace) -> None:
    port = resolve_port(args.port)
    subprocess.run(
        [str(FIRMWARE_VERSION_SCRIPT), "bump", args.version_bump],
        cwd=ROOT,
        check=True,
    )
    run([str(IDF), "idf.py", "-p", port, "flash"], cwd=FIRMWARE)


def nvs_location() -> tuple[int, int]:
    with NVS_PARTITION.open(newline="") as source:
        for row in csv.reader(line for line in source if not line.lstrip().startswith("#")):
            if row and row[0].strip() == "nvs":
                return int(row[3].strip(), 0), int(row[4].strip(), 0)
    raise SystemExit(f"NVS partition is missing from {NVS_PARTITION}")


def detected_host_address() -> str:
    connection = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
    try:
        connection.connect(("192.0.2.1", 9))
        return connection.getsockname()[0]
    except OSError:
        return ""
    finally:
        connection.close()


def prompt_default(label: str, default: str) -> str:
    suffix = f" [{default}]" if default else ""
    value = input(f"{label}{suffix}: ").strip()
    return value or default


def validate_provisioning(
    ssid: str,
    password: str,
    host: str,
    host_port: int,
    weather_name: str,
    weather_latitude: float,
    weather_longitude: float,
) -> None:
    if not 1 <= len(ssid.encode("utf-8")) <= 32:
        raise SystemExit("Wi-Fi SSID must contain 1-32 UTF-8 bytes.")
    if not 8 <= len(password.encode("utf-8")) <= 63:
        raise SystemExit("Wi-Fi password must contain 8-63 UTF-8 bytes for WPA2/WPA3 personal.")
    if not host or len(host.encode("utf-8")) > 253 or any(character.isspace() for character in host):
        raise SystemExit("Mac host address must be a valid IPv4 address or hostname without spaces.")
    if not 1 <= host_port <= 65535:
        raise SystemExit("Mac host port must be between 1 and 65535.")
    if not 1 <= len(weather_name.encode("utf-8")) <= 40:
        raise SystemExit("Weather location name must contain 1-40 UTF-8 bytes.")
    if not math.isfinite(weather_latitude) or not -90 <= weather_latitude <= 90:
        raise SystemExit("Weather latitude must be between -90 and 90.")
    if not math.isfinite(weather_longitude) or not -180 <= weather_longitude <= 180:
        raise SystemExit("Weather longitude must be between -180 and 180.")


def existing_board_id() -> str | None:
    try:
        value = json.loads(HOST_CONFIG.read_text())["boardID"]
    except (FileNotFoundError, KeyError, TypeError, json.JSONDecodeError):
        return None
    return value if isinstance(value, str) and value else None


def save_host_config(board_id: str, host_port: int) -> None:
    HOST_CONFIG.parent.mkdir(parents=True, exist_ok=True)
    payload = {"boardID": board_id, "port": host_port, "protocolVersion": 1}
    HOST_CONFIG.write_text(json.dumps(payload, indent=2, sort_keys=True) + "\n")
    os.chmod(HOST_CONFIG, 0o600)


def store_pairing(board_id: str, secret: bytes) -> None:
    swift = shutil.which("swift")
    if swift is None:
        raise SystemExit("Swift is required to store the board pairing in macOS Keychain.")
    run(
        [swift, "run", "--package-path", str(HOST_PACKAGE), "ilo-board-host", "pair", "--board-id", board_id, "--secret-stdin"],
        input_text=secret.hex() + "\n",
    )


def idf_python() -> Path:
    candidates = sorted(IDF_PYTHON_ROOT.glob("idf5.5_py*/bin/python"))
    if len(candidates) != 1:
        raise SystemExit("Cannot identify the pinned ESP-IDF Python environment. Run `./tools/setup-idf`.")
    return candidates[0]


def provision(args: argparse.Namespace) -> None:
    if not NVS_GENERATOR.is_file():
        raise SystemExit("ESP-IDF is not installed. Run `./tools/setup-idf` first.")
    python = idf_python()

    print("ILO Board secure provisioning")
    print("Secrets are read interactively, sent only through USB, and never written to this repository.")
    ssid = input("Wi-Fi SSID: ").strip()
    password = getpass.getpass("Wi-Fi password (hidden): ")
    host = prompt_default("Mac address on this Wi-Fi", detected_host_address())
    try:
        host_port = int(prompt_default("Mac service port", str(DEFAULT_HOST_PORT)))
    except ValueError as error:
        raise SystemExit("Mac service port must be a number.") from error
    weather_name = prompt_default("Weather location name", "Helsinki")
    try:
        weather_latitude = float(prompt_default("Weather latitude", "60.1699"))
        weather_longitude = float(prompt_default("Weather longitude", "24.9384"))
    except ValueError as error:
        raise SystemExit("Weather coordinates must be decimal numbers.") from error
    validate_provisioning(
        ssid,
        password,
        host,
        host_port,
        weather_name,
        weather_latitude,
        weather_longitude,
    )

    board_id = existing_board_id() or f"ilo-{uuid.uuid4()}"
    secret = secrets.token_bytes(32)
    store_pairing(board_id, secret)

    offset, size = nvs_location()
    with tempfile.TemporaryDirectory(prefix="ilo-board-provision-") as directory:
        temporary = Path(directory)
        csv_path = temporary / "provisioning.csv"
        image_path = temporary / "nvs.bin"
        with csv_path.open("w", newline="") as output:
            writer = csv.writer(output)
            writer.writerow(("key", "type", "encoding", "value"))
            writer.writerow(("ilo_board", "namespace", "", ""))
            writer.writerow(("wifi_ssid", "data", "string", ssid))
            writer.writerow(("wifi_password", "data", "string", password))
            writer.writerow(("board_id", "data", "string", board_id))
            writer.writerow(("host_address", "data", "string", host))
            writer.writerow(("host_port", "data", "u16", str(host_port)))
            writer.writerow(("psk", "data", "hex2bin", secret.hex()))
            writer.writerow(("weather_name", "data", "string", weather_name))
            writer.writerow(("weather_lat", "data", "string", f"{weather_latitude:.6f}"))
            writer.writerow(("weather_lon", "data", "string", f"{weather_longitude:.6f}"))
        os.chmod(csv_path, 0o600)
        run([str(python), str(NVS_GENERATOR), "generate", str(csv_path), str(image_path), hex(size)])

        print("\nPut the board in download mode:")
        print("  1. Hold BOOT")
        print("  2. Press and release RESET")
        print("  3. Release BOOT")
        input("Press Return when the board is ready... ")
        esptool(resolve_port(args.port), "write-flash", hex(offset), str(image_path))

    save_host_config(board_id, host_port)
    print("Provisioning verified and host configuration saved.")
    print(f"Board ID: {board_id}")
    print("Press and release RESET once without BOOT, then run `./tools/host menu`.")


def monitor(args: argparse.Namespace) -> None:
    port = resolve_port(args.port)
    run([str(IDF), "idf.py", "-p", port, "monitor"], cwd=FIRMWARE)


def reboot(args: argparse.Namespace) -> None:
    esptool(resolve_port(args.port), "run")


def erase(args: argparse.Namespace) -> None:
    if args.confirm != "ERASE-ENTIRE-BOARD":
        raise SystemExit("Refusing to erase. Re-run with --confirm ERASE-ENTIRE-BOARD.")
    esptool(resolve_port(args.port), "erase-flash")


def restore(args: argparse.Namespace) -> None:
    image = Path(args.image).expanduser().resolve()
    if args.confirm != "RESTORE-FACTORY-IMAGE":
        raise SystemExit("Refusing to overwrite flash. Re-run with --confirm RESTORE-FACTORY-IMAGE.")
    if not image.is_file() or image.stat().st_size != EXPECTED_FLASH_BYTES:
        raise SystemExit("Restore image must be an existing 16 MB full-flash backup.")
    esptool(resolve_port(args.port), "write-flash", "0x0", str(image))


def parser() -> argparse.ArgumentParser:
    result = argparse.ArgumentParser(prog="board", description=__doc__)
    sub = result.add_subparsers(dest="command", required=True)
    sub.add_parser("doctor", help="show local toolchain and USB status").set_defaults(handler=doctor)
    for name, help_text, handler in (
        ("chip-id", "identify the connected chip without changing flash", chip_id),
        ("backup", "read a verified 16 MB full-flash backup", backup),
        ("flash", "build as needed and flash the application", flash),
        ("monitor", "open the ESP-IDF serial monitor", monitor),
        ("reboot", "hard-reset the board", reboot),
    ):
        command = sub.add_parser(name, help=help_text)
        command.add_argument("--port")
        if name == "flash":
            command.add_argument(
                "--version-bump",
                choices=("patch", "minor"),
                default="patch",
                help="version increment applied after USB detection and before flashing (default: patch)",
            )
        command.set_defaults(handler=handler)
    provision_parser = sub.add_parser("provision", help="securely pair Wi-Fi and the Mac host through USB")
    provision_parser.add_argument("--port", help="serial port; auto-detected when omitted")
    provision_parser.set_defaults(handler=provision)

    preview_parser = sub.add_parser("ui-preview", help="open the desktop-rendered 1024x600 device UI (no board required)")
    preview_parser.add_argument("--without-x-news", action="store_true", help="preview the four-page layout used when X News is disabled")
    preview_parser.set_defaults(handler=ui_preview)

    screenshot_parser = sub.add_parser("ui-screenshot", help="render simulator PNGs; this is not a live board framebuffer capture")
    screenshot_parser.add_argument("--screen", choices=("dashboard", "codex", "x-news", "weather", "settings"), default="dashboard")
    screenshot_parser.add_argument("--all", action="store_true", help="render all five screens")
    screenshot_parser.add_argument("--output", help="output PNG path, or output directory with --all")
    screenshot_parser.set_defaults(handler=ui_screenshot)
    sub.add_parser("build", help="configure and build firmware").set_defaults(handler=build)
    ota_status_parser = sub.add_parser("ota-status", help="inspect dual-slot and signing gates without hardware")
    ota_status_parser.add_argument("--sdkconfig", help="sdkconfig to inspect; defaults to the current firmware build")
    ota_status_parser.set_defaults(handler=ota_status)
    ota_verify_parser = sub.add_parser("ota-verify", help="verify a signed release artifact without uploading it")
    ota_verify_parser.add_argument("--image", required=True, help="signed ESP32-S3 application binary")
    ota_verify_parser.add_argument("--public-key", required=True, help="RSA public verification key PEM; private keys are refused")
    ota_verify_parser.add_argument("--sdkconfig", required=True, help="sdkconfig used to build the release artifact")
    ota_verify_parser.set_defaults(handler=ota_verify)
    erase_parser = sub.add_parser("erase", help="erase the entire board (explicit confirmation required)")
    erase_parser.add_argument("--port")
    erase_parser.add_argument("--confirm")
    erase_parser.set_defaults(handler=erase)
    restore_parser = sub.add_parser("restore", help="restore a 16 MB full-flash backup")
    restore_parser.add_argument("image")
    restore_parser.add_argument("--port")
    restore_parser.add_argument("--confirm")
    restore_parser.set_defaults(handler=restore)
    return result


if __name__ == "__main__":
    arguments = parser().parse_args()
    arguments.handler(arguments)

#!/usr/bin/env python3
"""Safe board lifecycle CLI for Waveshare ESP32-S3-Touch-LCD-5B SKU 28151."""

from __future__ import annotations

import argparse
import csv
import datetime as dt
import getpass
import glob
import hashlib
import json
import os
from pathlib import Path
import secrets
import shutil
import socket
import subprocess
import sys
import tempfile
import uuid


ROOT = Path(__file__).resolve().parent.parent
FIRMWARE = ROOT / "firmware"
VENV = ROOT / ".tools" / "board-python"
ESPTOOL = VENV / "bin" / "esptool"
IDF = ROOT / "tools" / "idf"
EXPECTED_FLASH_BYTES = 0x1000000
NVS_PARTITION = ROOT / "firmware" / "partitions.csv"
NVS_GENERATOR = ROOT / ".tools" / "esp-idf" / "components" / "nvs_flash" / "nvs_partition_generator" / "nvs_partition_gen.py"
IDF_PYTHON_ROOT = ROOT / ".tools" / "espressif" / "python_env"
HOST_PACKAGE = ROOT / "mac-service"
HOST_CONFIG = Path.home() / "Library" / "Application Support" / "ILO Board Host" / "board.json"
DEFAULT_HOST_PORT = 47472


def candidate_ports() -> list[str]:
    patterns = (
        "/dev/cu.usbmodem*",
        "/dev/cu.usbserial*",
        "/dev/cu.wchusbserial*",
        "/dev/cu.SLAB_USBtoUART*",
    )
    ports: list[str] = []
    for pattern in patterns:
        ports.extend(glob.glob(pattern))
    return sorted(set(ports), key=lambda value: os.path.getmtime(value), reverse=True)


def resolve_port(explicit: str | None) -> str:
    if explicit:
        if not Path(explicit).exists():
            raise SystemExit(f"Serial port does not exist: {explicit}")
        return explicit
    ports = candidate_ports()
    if not ports:
        raise SystemExit("No ESP serial port found. Connect the board and run `./tools/board doctor`.")
    if len(ports) > 1:
        raise SystemExit("Multiple candidate ports found; pass --port explicitly:\n  " + "\n  ".join(ports))
    return ports[0]


def run(command: list[str], cwd: Path = ROOT, input_text: str | None = None) -> None:
    print("+ " + " ".join(command))
    subprocess.run(command, cwd=cwd, check=True, input=input_text, text=input_text is not None)


def ensure_esptool() -> None:
    if ESPTOOL.exists():
        return
    print("Creating isolated board utility environment...")
    VENV.parent.mkdir(parents=True, exist_ok=True)
    run([sys.executable, "-m", "venv", str(VENV)])
    run([str(VENV / "bin" / "python"), "-m", "pip", "install", "esptool==5.3.1", "pyserial==3.5"])


def esptool(port: str, *arguments: str) -> None:
    ensure_esptool()
    run([str(ESPTOOL), "--chip", "esp32s3", "--port", port, *arguments])


def doctor(_: argparse.Namespace) -> None:
    print("ILO Board doctor")
    print(f"  repository: {ROOT}")
    print(f"  ESP-IDF: {'installed' if (ROOT / '.tools/esp-idf/export.sh').exists() else 'not installed'}")
    print(f"  esptool: {'installed' if ESPTOOL.exists() else 'not installed (created on first hardware command)'}")
    ports = candidate_ports()
    if ports:
        for port in ports:
            print(f"  serial: {port}")
    else:
        print("  serial: no ESP-compatible port detected")
    print(f"  Swift: {shutil.which('swift') or 'not found'}")
    print(f"  CMake: {shutil.which('cmake') or 'not found'}")
    print(f"  Ninja: {shutil.which('ninja') or 'not found'}")


def chip_id(args: argparse.Namespace) -> None:
    esptool(resolve_port(args.port), "chip-id")


def backup(args: argparse.Namespace) -> None:
    port = resolve_port(args.port)
    output_dir = ROOT / "artifacts" / "factory-backups"
    output_dir.mkdir(parents=True, exist_ok=True)
    stamp = dt.datetime.now().astimezone().strftime("%Y-%m-%dT%H%M%S%z")
    output = output_dir / f"waveshare-esp32s3-{stamp}.bin"
    esptool(port, "read-flash", "--no-progress", "0x0", hex(EXPECTED_FLASH_BYTES), str(output))
    if output.stat().st_size != EXPECTED_FLASH_BYTES:
        raise SystemExit(f"Backup has unexpected size: {output.stat().st_size} bytes")
    digest = hashlib.sha256(output.read_bytes()).hexdigest()
    print(f"Backup: {output}")
    print(f"SHA-256: {digest}")


def build(_: argparse.Namespace) -> None:
    run([str(IDF), "idf.py", "-D", "IDF_TARGET=esp32s3", "build"], cwd=FIRMWARE)


def swift_preview(*arguments: str) -> None:
    swift = shutil.which("swift")
    if swift is None:
        raise SystemExit("Swift is not installed. Install Xcode Command Line Tools first.")
    run([swift, "run", "--package-path", str(HOST_PACKAGE), "ilo-board-preview", *arguments])


def ui_preview(_: argparse.Namespace) -> None:
    swift_preview("preview")


def ui_screenshot(args: argparse.Namespace) -> None:
    if args.all:
        arguments = ["screenshots"]
        if args.output:
            arguments.extend(("--output-dir", args.output))
    else:
        arguments = ["screenshot", "--screen", args.screen]
        if args.output:
            arguments.extend(("--output", args.output))
    swift_preview(*arguments)


def flash(args: argparse.Namespace) -> None:
    port = resolve_port(args.port)
    run([str(IDF), "idf.py", "-p", port, "flash"], cwd=FIRMWARE)


def nvs_location() -> tuple[int, int]:
    with NVS_PARTITION.open(newline="") as source:
        for row in csv.reader(line for line in source if not line.lstrip().startswith("#")):
            if row and row[0].strip() == "nvs":
                return int(row[3].strip(), 0), int(row[4].strip(), 0)
    raise SystemExit(f"NVS partition is missing from {NVS_PARTITION}")


def detected_host_address() -> str:
    connection = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
    try:
        connection.connect(("192.0.2.1", 9))
        return connection.getsockname()[0]
    except OSError:
        return ""
    finally:
        connection.close()


def prompt_default(label: str, default: str) -> str:
    suffix = f" [{default}]" if default else ""
    value = input(f"{label}{suffix}: ").strip()
    return value or default


def validate_provisioning(ssid: str, password: str, host: str, host_port: int) -> None:
    if not 1 <= len(ssid.encode("utf-8")) <= 32:
        raise SystemExit("Wi-Fi SSID must contain 1-32 UTF-8 bytes.")
    if not 8 <= len(password.encode("utf-8")) <= 63:
        raise SystemExit("Wi-Fi password must contain 8-63 UTF-8 bytes for WPA2/WPA3 personal.")
    if not host or len(host.encode("utf-8")) > 253 or any(character.isspace() for character in host):
        raise SystemExit("Mac host address must be a valid IPv4 address or hostname without spaces.")
    if not 1 <= host_port <= 65535:
        raise SystemExit("Mac host port must be between 1 and 65535.")


def existing_board_id() -> str | None:
    try:
        value = json.loads(HOST_CONFIG.read_text())["boardID"]
    except (FileNotFoundError, KeyError, TypeError, json.JSONDecodeError):
        return None
    return value if isinstance(value, str) and value else None


def save_host_config(board_id: str, host_port: int) -> None:
    HOST_CONFIG.parent.mkdir(parents=True, exist_ok=True)
    payload = {"boardID": board_id, "port": host_port, "protocolVersion": 1}
    HOST_CONFIG.write_text(json.dumps(payload, indent=2, sort_keys=True) + "\n")
    os.chmod(HOST_CONFIG, 0o600)


def store_pairing(board_id: str, secret: bytes) -> None:
    swift = shutil.which("swift")
    if swift is None:
        raise SystemExit("Swift is required to store the board pairing in macOS Keychain.")
    run(
        [swift, "run", "--package-path", str(HOST_PACKAGE), "ilo-board-host", "pair", "--board-id", board_id, "--secret-stdin"],
        input_text=secret.hex() + "\n",
    )


def idf_python() -> Path:
    candidates = sorted(IDF_PYTHON_ROOT.glob("idf5.5_py*/bin/python"))
    if len(candidates) != 1:
        raise SystemExit("Cannot identify the pinned ESP-IDF Python environment. Run `./tools/setup-idf`.")
    return candidates[0]


def provision(args: argparse.Namespace) -> None:
    if not NVS_GENERATOR.is_file():
        raise SystemExit("ESP-IDF is not installed. Run `./tools/setup-idf` first.")
    python = idf_python()

    print("ILO Board secure provisioning")
    print("Secrets are read interactively, sent only through USB, and never written to this repository.")
    ssid = input("Wi-Fi SSID: ").strip()
    password = getpass.getpass("Wi-Fi password (hidden): ")
    host = prompt_default("Mac address on this Wi-Fi", detected_host_address())
    try:
        host_port = int(prompt_default("Mac service port", str(DEFAULT_HOST_PORT)))
    except ValueError as error:
        raise SystemExit("Mac service port must be a number.") from error
    validate_provisioning(ssid, password, host, host_port)

    board_id = existing_board_id() or f"ilo-{uuid.uuid4()}"
    secret = secrets.token_bytes(32)
    store_pairing(board_id, secret)

    offset, size = nvs_location()
    with tempfile.TemporaryDirectory(prefix="ilo-board-provision-") as directory:
        temporary = Path(directory)
        csv_path = temporary / "provisioning.csv"
        image_path = temporary / "nvs.bin"
        with csv_path.open("w", newline="") as output:
            writer = csv.writer(output)
            writer.writerow(("key", "type", "encoding", "value"))
            writer.writerow(("ilo_board", "namespace", "", ""))
            writer.writerow(("wifi_ssid", "data", "string", ssid))
            writer.writerow(("wifi_password", "data", "string", password))
            writer.writerow(("board_id", "data", "string", board_id))
            writer.writerow(("host_address", "data", "string", host))
            writer.writerow(("host_port", "data", "u16", str(host_port)))
            writer.writerow(("psk", "data", "hex2bin", secret.hex()))
        os.chmod(csv_path, 0o600)
        run([str(python), str(NVS_GENERATOR), "generate", str(csv_path), str(image_path), hex(size)])

        print("\nPut the board in download mode:")
        print("  1. Hold BOOT")
        print("  2. Press and release RESET")
        print("  3. Release BOOT")
        input("Press Return when the board is ready... ")
        esptool(resolve_port(args.port), "write-flash", hex(offset), str(image_path))

    save_host_config(board_id, host_port)
    print("Provisioning verified and host configuration saved.")
    print(f"Board ID: {board_id}")
    print("Press and release RESET once without BOOT, then run `./tools/host menu`.")


def monitor(args: argparse.Namespace) -> None:
    port = resolve_port(args.port)
    run([str(IDF), "idf.py", "-p", port, "monitor"], cwd=FIRMWARE)


def reboot(args: argparse.Namespace) -> None:
    esptool(resolve_port(args.port), "run")


def erase(args: argparse.Namespace) -> None:
    if args.confirm != "ERASE-ENTIRE-BOARD":
        raise SystemExit("Refusing to erase. Re-run with --confirm ERASE-ENTIRE-BOARD.")
    esptool(resolve_port(args.port), "erase-flash")


def restore(args: argparse.Namespace) -> None:
    image = Path(args.image).expanduser().resolve()
    if args.confirm != "RESTORE-FACTORY-IMAGE":
        raise SystemExit("Refusing to overwrite flash. Re-run with --confirm RESTORE-FACTORY-IMAGE.")
    if not image.is_file() or image.stat().st_size != EXPECTED_FLASH_BYTES:
        raise SystemExit("Restore image must be an existing 16 MB full-flash backup.")
    esptool(resolve_port(args.port), "write-flash", "0x0", str(image))


def parser() -> argparse.ArgumentParser:
    result = argparse.ArgumentParser(prog="board", description=__doc__)
    sub = result.add_subparsers(dest="command", required=True)
    sub.add_parser("doctor", help="show local toolchain and USB status").set_defaults(handler=doctor)
    for name, help_text, handler in (
        ("chip-id", "identify the connected chip without changing flash", chip_id),
        ("backup", "read a verified 16 MB full-flash backup", backup),
        ("flash", "build as needed and flash the application", flash),
        ("monitor", "open the ESP-IDF serial monitor", monitor),
        ("reboot", "hard-reset the board", reboot),
    ):
        command = sub.add_parser(name, help=help_text)
        command.add_argument("--port")
        command.set_defaults(handler=handler)
    provision_parser = sub.add_parser("provision", help="securely pair Wi-Fi and the Mac host through USB")
    provision_parser.add_argument("--port", help="serial port; auto-detected when omitted")
    provision_parser.set_defaults(handler=provision)

    preview_parser = sub.add_parser("ui-preview", help="open the desktop-rendered 1024x600 device UI (no board required)")
    preview_parser.set_defaults(handler=ui_preview)

    screenshot_parser = sub.add_parser("ui-screenshot", help="render simulator PNGs; this is not a live board framebuffer capture")
    screenshot_parser.add_argument("--screen", choices=("dashboard", "codex", "weather", "settings"), default="dashboard")
    screenshot_parser.add_argument("--all", action="store_true", help="render all four screens")
    screenshot_parser.add_argument("--output", help="output PNG path, or output directory with --all")
    screenshot_parser.set_defaults(handler=ui_screenshot)
    sub.add_parser("build", help="configure and build firmware").set_defaults(handler=build)
    erase_parser = sub.add_parser("erase", help="erase the entire board (explicit confirmation required)")
    erase_parser.add_argument("--port")
    erase_parser.add_argument("--confirm")
    erase_parser.set_defaults(handler=erase)
    restore_parser = sub.add_parser("restore", help="restore a 16 MB full-flash backup")
    restore_parser.add_argument("image")
    restore_parser.add_argument("--port")
    restore_parser.add_argument("--confirm")
    restore_parser.set_defaults(handler=restore)
    return result


if __name__ == "__main__":
    arguments = parser().parse_args()
    arguments.handler(arguments)

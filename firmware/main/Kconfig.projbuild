menu "ILO Board"
    comment "Wi-Fi and pairing settings are provisioned at runtime with ./tools/board provision"

    config ILO_OTA_VALIDATION_SECONDS
        int "Stable runtime required before confirming a new OTA image"
        range 10 300
        default 30
        help
            A first-boot OTA image remains pending until the display/UI core has
            initialized and the firmware has stayed alive for this interval.

    config ILO_OTA_MIN_INTERNAL_HEAP
        int "Minimum free internal heap required to confirm an OTA image"
        range 16384 262144
        default 32768
        help
            A pending image is rolled back instead of confirmed when internal
            heap falls below this conservative health threshold.
endmenu
